# Names only. Copy to the stack .env on the server.

# Host port from the server port register (container port = host port). Required.
# 8071 confirmed by James (next free after finance-hub 8070).
PORT_HOST=8071
# Timezone
TZ=America/Toronto
# Fast storage (database, screenshots) and slow storage; defaults match the server.
FAST_STORAGE=/srv/dev-disk-by-uuid-758425e9-f9ca-4fbc-ad81-eaea80fdfb73/appdata-ssd
